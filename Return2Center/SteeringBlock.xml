<Block>
<Debug>false</Debug>
<ID>2</ID>
<Name>Steering Block R2C</Name>
<Mass>1</Mass>
<SearchKeywords>
<Keyword>steering block return to center R2C</Keyword>
</SearchKeywords>
<CanFlip>true</CanFlip>
<Fallback>SteeringBlock</Fallback>

<ModuleMapperTypes>
	<Key displayName="Left" key="left" default="LeftArrow" />
	<Key displayName="Right" key="right" default="RightArrow" />
	<Slider displayName="Rotation Speed" key="RotationalSpeed" min="0.0" max="2.0" default="1.0" />
	<Slider displayName="Tension" key="tension" min="0.5" max="2.0" default="1.0" />
	<Toggle displayName="Toggle" key="PushToggle" default="false"/>
</ModuleMapperTypes>

<Modules>
