		<LimitsDefaultMin>40</LimitsDefaultMin>
		<LimitsDefaultMax>40</LimitsDefaultMax>
		<LimitsHighestAngle>180</LimitsHighestAngle>
		<FlipLimits>True</FlipLimits>
	</R2CSteering>
</Modules>

