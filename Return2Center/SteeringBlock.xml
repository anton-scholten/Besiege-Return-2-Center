		<RightKey key="right" />
		<SpeedSlider key="RotationalSpeed" />
		<TensionSlider key="tension" />
		<PushToggle key="PushToggle" />
		<Axis>Y</Axis>
		<MaxAngularSpeed>100</MaxAngularSpeed>
		<TargetAngleSpeed>1</TargetAngleSpeed>
		<HasLimits>True</HasLimits>
		<LimitsDisplay>
			<Position x="0" y="0.1" z="0" />
